# =================================================================
# API Security Analytics & Active Defense Platform — Environment Config
# =================================================================
# Copy this file to .env and configure the values for your environment.
# DO NOT commit real secrets or credentials to source control.

# -----------------------------------------------------------------
# 1. Environment Profile
# -----------------------------------------------------------------
# Options: development | staging | production
ENVIRONMENT=development
PORT=5001

# -----------------------------------------------------------------
# 2. Database Persistence Layer
# -----------------------------------------------------------------
# Production / Staging: High-concurrency PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres_secure_pass@localhost:5432/mlo11y_production

# Local Development / Testing Fallback (defaults to backend/events.db if omitted):
# DATABASE_URL=sqlite:///backend/events.db

# -----------------------------------------------------------------
# 3. Cryptographic Secrets & Session Management
# -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: Must be changed in production environments!
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-key-in-production

# Enforce secure cookies over HTTPS (strictly True in production & staging)
SESSION_COOKIE_SECURE=false

# SaaS Base URL (used in email verification & password reset links)
APP_BASE_URL=http://localhost:5001

# -----------------------------------------------------------------
# 4. CORS & Ingestion Collector Configuration
# -----------------------------------------------------------------
# Restrict to your production domain(s) in production (e.g. https://dashboard.yourcompany.com)
# Set to * only during local development
CORS_ALLOWED_ORIGINS=*

# Max request body bounds (5 MB default prevents volumetric denial-of-service)
MAX_CONTENT_LENGTH=5242880

# Telemetry ingestion bounds (64 KB per single event)
COLLECTOR_MAX_PAYLOAD_BYTES=65536

# SDK Client Ingestion Token Bucket Rate Limits
RATE_LIMIT_PER_MINUTE=50
RATE_LIMIT_BURST=30

# -----------------------------------------------------------------
# 5. Generative AI Threat Analyst (Google Gemini)
# -----------------------------------------------------------------
# Server-side API key for autonomous incident analysis (never sent to client)
# Obtain from Google AI Studio: https://aistudio.google.com/
# If left empty, platform automatically runs in Heuristic Threat Analysis mode.
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------
# 6. Google Cloud OAuth 2.0 / OpenID Connect
# -----------------------------------------------------------------
# Obtain from Google Cloud Console > APIs & Services > Credentials
# Authorized Redirect URI must match GOOGLE_REDIRECT_URI exactly.
# Dev:  http://127.0.0.1:5001/auth/google/callback
# Prod: https://api.yourcompany.com/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:5001/auth/google/callback

# -----------------------------------------------------------------
# 7. Integrations & Notification Webhooks
# -----------------------------------------------------------------
# Global fallback webhook for legacy default demo project.
# Individual projects configure and test their own Slack / Discord webhooks in the UI.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# -----------------------------------------------------------------
# 8. Transactional Email (SMTP)
# -----------------------------------------------------------------
# If omitted or unconfigured, verification and reset emails are written
# to the local logger and in-memory test mailbox for safe local development.
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your_sendgrid_or_smtp_password
# SMTP_FROM=security-alerts@yourdomain.com
# SMTP_USE_TLS=true
